# Modelo do arquivo .env. O .env de verdade NÃO vai para o Git.
# Se o .env não existir, scripts/preparar.sh cria um a partir deste modelo e
# troca cada "GERAR" por uma senha aleatória.

# Ao deixar "true" você declara que leu e aceita a EULA do Minecraft:
# https://aka.ms/MinecraftEULA
ACEITO_EULA=true

# Memória da JVM (Xms = Xmx). No computador do dono 4G basta; em produção,
# num plano de 8 GB, use 6500M para sobrar memória fora do heap.
MEMORIA=4G

# Porta do jogo.
PORTA=25565

# Texto que aparece na lista de servidores do jogo.
MOTD=Servidor de RP em desenvolvimento

# Máximo de jogadores simultâneos.
MAX_JOGADORES=60

# Semente do mundo (vazio = aleatória).
SEMENTE=

# Resource pack do servidor. Deixe os dois vazios enquanto não houver pack.
# Quando a URL estiver preenchida, o pack passa a ser obrigatório.
PACK_URL=
PACK_SHA1=

# --- Segredos. Só letras, números, "_" e "-". ---
# Senha do RCON (usada pelo contêiner para parar o servidor e, depois, pelo backup).
# A porta do RCON (25575) nunca deve ser aberta para a internet.
SENHA_RCON=GERAR
# Segredo do servidor de gerenciamento do Minecraft (fica desligado; o valor só
# precisa existir e ser secreto).
SEGREDO_GERENCIAMENTO=GERAR
