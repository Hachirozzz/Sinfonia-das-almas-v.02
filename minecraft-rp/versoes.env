# Versões fixadas do servidor. Lido pelos scripts (bash) e pelo docker-compose
# (env_file), por isso os nomes VERSION, PAPER_BUILD e JVM_XX_OPTS são os que a
# imagem itzg/minecraft-server espera. Não coloque segredos aqui.
#
# Conferido em 10/nov/2026 em https://fill.papermc.io/v3/projects/paper/versions/26.2/builds
# Motivo da escolha: ver DECISOES.md, seção "Stack técnica".
VERSION=26.2
PAPER_BUILD=135
PAPER_JAR_URL=https://fill-data.papermc.io/v1/objects/ef3dbc68b013deafdbbee3bebf1ba351671ebcda94a8f136809b7532d5ba2fe1/paper-26.2-135.jar
PAPER_JAR_SHA256=ef3dbc68b013deafdbbee3bebf1ba351671ebcda94a8f136809b7532d5ba2fe1

# Java 25 (Amazon Corretto, Linux x64), usado só no modo Java puro.
# No Docker o Java vem da imagem itzg/minecraft-server:java25.
# Hash publicado em https://corretto.aws/downloads/latest_sha256/amazon-corretto-25-x64-linux-jdk.tar.gz
JAVA25_VERSAO=25.0.5.0.10
JAVA25_URL=https://corretto.aws/downloads/resources/25.0.5.0.10/amazon-corretto-25.0.5.0.10-linux-x64.tar.gz
JAVA25_SHA256=1d89b4194f20ee513f4dd9fc2aadd038de3c713c37fd444d77566b3da7b0ee65

# Flags de JVM recomendadas pelo Paper para a 26.2 (campo java.flags.recommended
# de https://fill.papermc.io/v3/projects/paper/versions/26.2).
JVM_XX_OPTS="-XX:+AlwaysPreTouch -XX:+DisableExplicitGC -XX:+ParallelRefProcEnabled -XX:+PerfDisableSharedMem -XX:+UnlockExperimentalVMOptions -XX:+UseG1GC -XX:G1HeapRegionSize=8M -XX:G1HeapWastePercent=5 -XX:G1MaxNewSizePercent=40 -XX:G1MixedGCCountTarget=4 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1NewSizePercent=30 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -XX:MaxGCPauseMillis=200 -XX:MaxTenuringThreshold=1 -XX:SurvivorRatio=32"
